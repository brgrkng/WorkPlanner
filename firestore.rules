rules_version = '2';

// WorkPlanner — single-user Firestore rules.
//
// THIS FILE IS THE ACTUAL SECURITY BOUNDARY, not the API key.
//
// The Firebase web config (apiKey, projectId, ...) is not a secret: it ships in
// every client bundle by design and Google's own docs say so. Keeping it out of
// the public repo is still worth doing, but it protects nothing on its own.
// What stops someone reading or wiping this data is exactly the rules below.
//
// SETUP: replace REPLACE_WITH_YOUR_UID with the UID of the single account you
// create in the Firebase console (Authentication -> Users -> the "User UID"
// column). Until you do, every request is denied — which is the safe default.

service cloud.firestore {
  match /databases/{database}/documents {

    // The one account that may touch anything.
    function isOwner() {
      return request.auth != null
          && request.auth.uid == 'REPLACE_WITH_YOUR_UID';
    }

    // Day logs and the meta document live under the owner's own subtree.
    //
    // Pinning to a specific UID rather than `request.auth.uid == userId` is
    // deliberate: email/password sign-up is open by default on a Firebase
    // project, so the looser rule would let any stranger create an account and
    // write into their own subtree of your database, burning your quota.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner() && userId == request.auth.uid;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
